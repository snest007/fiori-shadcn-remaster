{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["registry/ui/*"],
      "@/lib/*": ["registry/lib/*"],
      "@/components/blocks/*": ["registry/blocks/*"],
      "@/docs/*": ["docs/src/*"]
    }
  },
  "include": ["registry", "docs/src", "tests", "vite.config.ts", "playwright.config.ts", "vite.aliases.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx", "docs/stories", "tests-storybook", "playwright.storybook.config.ts"]
}
